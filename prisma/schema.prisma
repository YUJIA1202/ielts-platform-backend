generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model OutlineViewLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String // 格式 "2026-04-12"
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model User {
  id             Int              @id @default(autoincrement())
  phone          String           @unique
  username       String
  password       String?
  avatar         String?
  registrationIp String?
  targetScore    Float?
  currentScore   Float?
  examDate       DateTime?
  studyFocus     String?
  weeklyHours    Int?
  role           Role             @default(USER)
  subscription   SubscriptionTier @default(FREE)
  subExpiresAt   DateTime?
  banned         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  submissions      Submission[]
  payments         Payment[]
  loginSessions    LoginSession[]
  trialLogs        VideoTrialLog[]
  correctionCodes  CorrectionCode[]
  messages         Message[]
  essayViewLogs    EssayViewLog[]
  questionViewLogs QuestionViewLog[]
  reflections      Reflection[]
  outlineViewLogs  OutlineViewLog[]
  examSessions     ExamSession[]
  aiReviewRequests AiReviewRequest[]
  aiReviewJobs     AiReviewJob[]
  aiReviews        AiReview[]
  aiModelCalls     AiModelCall[]
  humanAudits      HumanReviewAudit[]
  practiceProfile  PracticeProfile?
  practiceSessions PracticeSession[]
  practiceAttempts PracticeAttempt[]
}

model LoginSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @db.Text
  deviceId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Question {
  id                  Int       @id @default(autoincrement())
  canonicalQuestionId Int?
  task                TaskType
  subtype             String?
  topic               String?
  topicCategory       String?
  topicSubcategory    String?   @db.Text
  content             String    @db.Text
  outline             String?   @db.Text
  imageUrl            String?
  source              String?
  sourceKey           String?   @unique
  sourceRow           Int?
  examDate            DateTime?
  testMode            String?
  region              String?
  similarGroup        String?
  year                Int?
  month               Int?
  createdAt           DateTime  @default(now())

  essays                ModelEssay[]
  submissions           Submission[]
  viewLogs              QuestionViewLog[]
  primaryExamSessions   ExamSession[]       @relation("PrimaryExamQuestion")
  secondaryExamSessions ExamSession[]       @relation("SecondaryExamQuestion")
  aiReviewRequests      AiReviewRequest[]
  knowledgeDocuments    KnowledgeDocument[]
  canonicalQuestion     CanonicalQuestion?  @relation(fields: [canonicalQuestionId], references: [id], onDelete: SetNull)

  @@index([task, subtype])
  @@index([task, topicCategory])
  @@index([year, month])
  @@index([examDate])
  @@index([canonicalQuestionId])
}

// Stable identity for one IELTS prompt across the question bank, model essays,
// teacher reviews, and repeated student submissions. Existing Question rows and
// public APIs remain unchanged; this table only supplies a shared RAG key.
model CanonicalQuestion {
  id               Int       @id @default(autoincrement())
  promptHash       String    @unique @db.VarChar(64)
  normalizedPrompt String    @db.LongText
  displayPrompt    String    @db.LongText
  task             TaskType?
  subtype          String?
  topic            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  questions          Question[]
  knowledgeDocuments KnowledgeDocument[]

  @@index([task, subtype])
  @@index([topic])
}

model ExamSession {
  id                  Int               @id @default(autoincrement())
  userId              Int
  primaryQuestionId   Int
  secondaryQuestionId Int?
  mode                ExamMode
  status              ExamSessionStatus @default(IN_PROGRESS)
  primaryAnswer       String?           @db.LongText
  secondaryAnswer     String?           @db.LongText
  durationSeconds     Int
  elapsedSeconds      Int               @default(0)
  currentPart         Int               @default(1)
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user              User      @relation(fields: [userId], references: [id])
  primaryQuestion   Question  @relation("PrimaryExamQuestion", fields: [primaryQuestionId], references: [id])
  secondaryQuestion Question? @relation("SecondaryExamQuestion", fields: [secondaryQuestionId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

model ModelEssay {
  id              Int      @id @default(autoincrement())
  questionId      Int
  content         String   @db.LongText
  pdfUrl          String?
  annotatedPdfUrl String?
  score           Float?
  createdAt       DateTime @default(now())

  viewLogs    EssayViewLog[]
  question    Question       @relation(fields: [questionId], references: [id])
  annotations String?        @db.LongText
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  category    String
  series      String
  seriesOrder Int      @default(0)
  duration    Int
  url         String
  coverUrl    String?
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())

  trialLogs VideoTrialLog[]
}

model VideoTrialLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoId   Int
  date      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Submission {
  id            Int              @id @default(autoincrement())
  userId        Int
  questionId    Int?
  customPrompt  String?          @db.Text
  imageUrl      String?
  content       String?          @db.LongText
  wordFileUrl   String?
  status        SubmissionStatus @default(PENDING)
  score         Float?
  feedbackUrl   String?
  taScore       Float?
  ccScore       Float?
  lrScore       Float?
  graScore      Float?
  overallScore  Float?
  adminComment  String?          @db.Text
  reviewFileUrl String?
  reviewTask    String?
  reviewSubtype String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  question         Question?         @relation(fields: [questionId], references: [id])
  correctionCode   CorrectionCode?
  reflections      Reflection[]
  aiReviewRequests AiReviewRequest[]
  aiReviews        AiReview[]
}

model AiReviewRequest {
  id               Int                   @id @default(autoincrement())
  userId           Int
  questionId       Int?
  submissionId     Int?
  sourceType       AiReviewSourceType    @default(DIRECT_AI)
  task             TaskType?
  subtype          String?
  topic            String?
  questionText     String?               @db.LongText
  questionImageUrl String?
  essayText        String                @db.LongText
  status           AiReviewRequestStatus @default(PENDING)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  question   Question?     @relation(fields: [questionId], references: [id])
  submission Submission?   @relation(fields: [submissionId], references: [id])
  jobs       AiReviewJob[]
  reviews    AiReview[]

  @@index([userId, createdAt])
  @@index([status])
}

model AiReviewJob {
  id           Int               @id @default(autoincrement())
  userId       Int
  requestId    Int
  status       AiReviewJobStatus @default(PENDING)
  stage        String            @default("created")
  errorCode    String?
  errorMessage String?           @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user            User                   @relation(fields: [userId], references: [id])
  request         AiReviewRequest        @relation(fields: [requestId], references: [id])
  snapshot        AiReviewInputSnapshot?
  review          AiReview?
  modelCalls      AiModelCall[]
  retrievalEvents RetrievalEvent[]
  stageResults    AiReviewStageResult[]

  @@index([userId, createdAt])
  @@index([status])
}

model AiReviewInputSnapshot {
  id                 Int       @id @default(autoincrement())
  jobId              Int       @unique
  normalizedQuestion String?   @db.LongText
  normalizedEssay    String    @db.LongText
  sentenceJson       Json
  paragraphJson      Json
  wordCount          Int
  detectedTask       TaskType?
  detectedSubtype    String?
  detectedTopic      String?
  createdAt          DateTime  @default(now())

  job AiReviewJob @relation(fields: [jobId], references: [id])
}

model AiReview {
  id             Int      @id @default(autoincrement())
  jobId          Int      @unique
  requestId      Int
  userId         Int
  submissionId   Int?
  overallBand    Float?
  summary        String   @db.LongText
  priorityAdvice String?  @db.LongText
  provider       String
  model          String
  promptVersion  String?
  rawOutput      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job              AiReviewJob            @relation(fields: [jobId], references: [id])
  request          AiReviewRequest        @relation(fields: [requestId], references: [id])
  user             User                   @relation(fields: [userId], references: [id])
  submission       Submission?            @relation(fields: [submissionId], references: [id])
  scores           AiReviewScore[]
  findings         AiGlobalFinding[]
  annotations      AiSentenceAnnotation[]
  rewrites         AiRewrite[]
  audits           HumanReviewAudit[]
  practiceSessions PracticeSession[]

  @@index([userId, createdAt])
  @@index([requestId])
}

model AiReviewScore {
  id        Int                    @id @default(autoincrement())
  reviewId  Int
  dimension AiReviewScoreDimension
  score     Float?
  rationale String                 @db.Text
  evidence  String?                @db.Text
  createdAt DateTime               @default(now())

  review AiReview @relation(fields: [reviewId], references: [id])

  @@unique([reviewId, dimension])
}

model AiGlobalFinding {
  id          Int               @id @default(autoincrement())
  reviewId    Int
  category    AiFindingCategory
  severity    AiIssueSeverity   @default(MEDIUM)
  title       String
  explanation String            @db.LongText
  suggestion  String?           @db.LongText
  createdAt   DateTime          @default(now())

  review AiReview @relation(fields: [reviewId], references: [id])

  @@index([reviewId, category])
}

model AiSentenceAnnotation {
  id                 Int                        @id @default(autoincrement())
  reviewId           Int
  paragraphIndex     Int?
  sentenceIndex      Int?
  level              AiAnnotationLevel          @default(SENTENCE)
  originalText       String                     @db.LongText
  anchorText         String?                    @db.Text
  anchorType         AnchorType?
  startOffset        Int?
  endOffset          Int?
  occurrence         Int?
  attachedTokenIndex Int?
  sourceRef          String?
  targetRef          String?
  relationType       RelationType?
  locationStatus     AiAnnotationLocationStatus @default(PENDING)
  issueType          AiIssueType
  subtype            String?
  severity           AiIssueSeverity            @default(MEDIUM)
  explanation        String                     @db.LongText
  suggestion         String?                    @db.LongText
  replacementText    String?                    @db.LongText
  rubricDimension    AiReviewScoreDimension?
  createdAt          DateTime                   @default(now())

  review AiReview @relation(fields: [reviewId], references: [id])

  @@index([reviewId, sentenceIndex])
  @@index([issueType])
  @@index([anchorType])
}

model AiRewrite {
  id             Int                 @id @default(autoincrement())
  reviewId       Int
  sentenceIndex  Int?
  paragraphIndex Int?
  level          AiAnnotationLevel   @default(SENTENCE)
  rewriteLayer   AiRewriteLayer?
  operation      AiRevisionOperation @default(REPLACE)
  anchorText     String?             @db.Text
  startOffset    Int?
  endOffset      Int?
  occurrence     Int?
  originalText   String              @db.LongText
  rewrittenText  String              @db.LongText
  reason         String?             @db.LongText
  createdAt      DateTime            @default(now())

  review AiReview @relation(fields: [reviewId], references: [id])

  @@index([reviewId, sentenceIndex])
}

// Practice is downstream of the review and knowledge pipelines. Items are
// generated offline from traceable knowledge sources; answers never need to be
// sent to the browser before an attempt is judged.
model PracticeItem {
  id                String             @id @default(cuid())
  tab               PracticeTab
  itemType          PracticeItemType
  topic             String?
  questionSubtype   String?
  issueTypes        Json
  difficulty        PracticeDifficulty @default(CORE)
  stem              String             @db.Text
  materials         Json
  options           Json?
  answerKey         Json
  acceptableAnswers Json?
  judgePoints       Json
  explanation       String             @db.LongText
  sourceRefs        Json
  status            PracticeItemStatus @default(DRAFT)
  stats             Json
  version           Int                @default(1)
  changelog         Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  attempts PracticeAttempt[]

  @@index([tab, status])
  @@index([topic, questionSubtype])
  @@index([itemType, status])
}

model PracticeProfile {
  studentId     Int      @id
  issueCounters Json
  sourceEssays  Json
  masteryFlags  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Operational session state is kept separately from the four core domain
// tables so Tab 5/6 can later be opened from either a review or Navigator.
model PracticeSession {
  id              String                @id @default(cuid())
  studentId       Int
  aiReviewId      Int?
  mode            PracticeSessionMode
  tab             PracticeTab
  topic           String?
  questionSubtype String?
  itemIds         Json
  profileSnapshot Json?
  status          PracticeSessionStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  completedAt     DateTime?

  user     User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  aiReview AiReview?         @relation(fields: [aiReviewId], references: [id], onDelete: SetNull)
  attempts PracticeAttempt[]

  @@index([studentId, createdAt])
  @@index([aiReviewId])
  @@index([tab, status])
}

model PracticeAttempt {
  id               String               @id @default(cuid())
  studentId        Int
  sessionId        String
  itemId           String
  answerPayload    Json
  verdict          PracticeVerdict
  judgedBy         PracticeJudgedBy
  judgeRationale   String?              @db.Text
  fixed            Json?
  remaining        Json?
  appealStatus     PracticeAppealStatus @default(NONE)
  appealReason     String?              @db.Text
  appealResolution String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user    User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    PracticeItem    @relation(fields: [itemId], references: [id])

  @@index([studentId, createdAt])
  @@index([sessionId, itemId])
  @@index([itemId, verdict])
  @@index([appealStatus])
}

model TopicErrorStat {
  id              Int      @id @default(autoincrement())
  topic           String
  questionSubtype String
  issueType       String
  frequency       Int
  share           Float
  sourceVersion   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([topic, questionSubtype, issueType])
  @@index([topic, questionSubtype])
  @@index([issueType])
}

model AiModelCall {
  id            Int               @id @default(autoincrement())
  userId        Int
  jobId         Int?
  callType      AiModelCallType
  provider      String
  model         String
  promptVersion String?
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float?
  latencyMs     Int?
  status        AiModelCallStatus @default(SUCCESS)
  errorMessage  String?           @db.Text
  createdAt     DateTime          @default(now())

  user User         @relation(fields: [userId], references: [id])
  job  AiReviewJob? @relation(fields: [jobId], references: [id])

  @@index([userId, createdAt])
  @@index([jobId])
}

model AiReviewStageResult {
  id               Int                     @id @default(autoincrement())
  jobId            Int
  stage            AiReviewStage
  targetIndex      Int?
  attempt          Int                     @default(1)
  provider         String
  model            String
  promptVersion    String?
  inputJson        Json?
  outputJson       Json?
  validationStatus AiStageValidationStatus @default(PENDING)
  errorMessage     String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  job AiReviewJob @relation(fields: [jobId], references: [id])

  @@index([jobId, stage, targetIndex])
}

model AiPromptTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  purpose   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions AiPromptVersion[]

  @@unique([name, purpose])
}

model AiPromptVersion {
  id               Int      @id @default(autoincrement())
  templateId       Int
  version          String
  content          String   @db.LongText
  outputSchemaJson Json?
  changelog        String?  @db.Text
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())

  template AiPromptTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, version])
  @@index([isActive])
}

model AiProviderConfig {
  id             Int      @id @default(autoincrement())
  provider       String   @unique
  displayName    String
  baseUrl        String?
  defaultModel   String?
  enabled        Boolean  @default(true)
  complianceNote String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model KnowledgeSource {
  id         Int                 @id @default(autoincrement())
  sourceType KnowledgeSourceType
  title      String
  owner      String?
  visibility KnowledgeVisibility @default(PRIVATE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  documents KnowledgeDocument[]
}

model KnowledgeDocument {
  id                  Int       @id @default(autoincrement())
  sourceId            Int
  questionId          Int?
  canonicalQuestionId Int?
  title               String
  rawText             String    @db.LongText
  fileUrl             String?
  task                TaskType?
  subtype             String?
  topic               String?
  band                Float?

  // ── V6 Phase3: 数据质量标记 ──────────────────────────────────
  // 内容角色（是什么）
  contentRole        String? // REVIEW_EXAMPLE | MODEL_ESSAY | MODEL_PARAGRAPH
  // TEACHING_NOTE | MIXED | NEEDS_REVIEW
  // 完整性状态（有多完整）
  completenessStatus String? // COMPLETE | PARTIAL | MISSING_PROMPT
  // MULTI_ESSAY_DOCUMENT | MIXED_TASK_DOCUMENT | NEEDS_REVIEW
  // 推断题型（不覆盖 task，task 冻结直到人工确认）
  probableTask       TaskType?
  // RAG 检索开关
  allowedForRag      Boolean   @default(true)
  // 评估集排除开关
  excludeFromEval    Boolean   @default(false)
  // 自动分类理由（| 分隔，便于人工审核）
  qualityNotes       String?   @db.Text
  // ─────────────────────────────────────────────────────────────

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source            KnowledgeSource           @relation(fields: [sourceId], references: [id])
  question          Question?                 @relation(fields: [questionId], references: [id], onDelete: SetNull)
  canonicalQuestion CanonicalQuestion?        @relation(fields: [canonicalQuestionId], references: [id], onDelete: SetNull)
  chunks            KnowledgeChunk[]
  annotations       KnowledgeAnnotation[]
  textUnits         KnowledgeTextUnit[]
  assessments       KnowledgeAssessment[]
  rewriteExamples   KnowledgeRewriteExample[]
  sourceRecords     KnowledgeSourceRecord[]

  @@index([sourceId])
  @@index([questionId])
  @@index([canonicalQuestionId])
  @@index([task, subtype])
  @@index([contentRole])
  @@index([allowedForRag])
  @@index([excludeFromEval])
}

model KnowledgeChunk {
  id         Int                @id @default(autoincrement())
  documentId Int
  chunkText  String             @db.LongText
  chunkType  KnowledgeChunkType
  task       TaskType?
  subtype    String?
  topic      String?
  band       Float?
  tokenCount Int?
  createdAt  DateTime           @default(now())

  document      KnowledgeDocument       @relation(fields: [documentId], references: [id])
  embeddings    KnowledgeEmbedding[]
  retrievalHits RetrievalEventChunk[]
  annotations   KnowledgeAnnotation[]
  goldStandards RetrievalGoldStandard[]
  hardNegatives RetrievalHardNegative[]
  assessments   KnowledgeAssessment[]

  @@index([documentId])
  @@index([task, subtype])
  @@index([chunkType])
}

// Lossless, stable paragraph/sentence units extracted from source documents.
// KnowledgeChunk remains a rebuildable retrieval projection; these units are
// the canonical anchors for assessments, evidence, and rewrites.
model KnowledgeTextUnit {
  id             Int      @id @default(autoincrement())
  documentId     Int
  parentId       Int?
  unitType       String
  stableKey      String
  versionId      String?
  ordinal        Int
  paragraphIndex Int?
  sentenceIndex  Int?
  text           String   @db.LongText
  startOffset    Int?
  endOffset      Int?
  sourceSheet    String?
  sourceRow      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  document           KnowledgeDocument             @relation(fields: [documentId], references: [id])
  parent             KnowledgeTextUnit?            @relation("KnowledgeTextUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           KnowledgeTextUnit[]           @relation("KnowledgeTextUnitTree")
  primaryAssessments KnowledgeAssessment[]         @relation("KnowledgeAssessmentPrimaryUnit")
  primaryFindings    KnowledgeAssessmentFinding[]  @relation("KnowledgeFindingPrimaryUnit")
  evidenceRefs       KnowledgeAssessmentEvidence[]
  rewriteExamples    KnowledgeRewriteExample[]

  @@unique([documentId, stableKey])
  @@index([documentId, unitType])
  @@index([documentId, paragraphIndex, sentenceIndex])
  @@index([parentId])
}

// Complete source assessment container. rawFeedback always preserves the
// original long Excel evaluation even when it is decomposed into findings.
model KnowledgeAssessment {
  id            Int      @id @default(autoincrement())
  documentId    Int
  chunkId       Int?
  primaryUnitId Int?
  sourceKey     String
  kind          String
  scope         String
  dimension     String?
  score         Float?
  status        String?
  tags          Json?
  rawFeedback   String   @db.LongText
  sourceSheet   String?
  sourceRow     Int?
  sourceColumn  String?
  rawJson       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  document    KnowledgeDocument            @relation(fields: [documentId], references: [id])
  chunk       KnowledgeChunk?              @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  primaryUnit KnowledgeTextUnit?           @relation("KnowledgeAssessmentPrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: SetNull)
  findings    KnowledgeAssessmentFinding[]

  @@unique([documentId, sourceKey])
  @@index([documentId, scope, dimension])
  @@index([chunkId])
  @@index([primaryUnitId])
  @@index([kind])
}

// Atomic opinion inside a complete assessment container. Offsets point into
// KnowledgeAssessment.rawFeedback so the UI can keep the long-form review and
// still connect a selected clause to precise source evidence.
model KnowledgeAssessmentFinding {
  id                  Int      @id @default(autoincrement())
  assessmentId        Int
  primaryUnitId       Int?
  ordinal             Int
  scope               String
  kind                String
  content             String   @db.LongText
  feedbackStartOffset Int?
  feedbackEndOffset   Int?
  confidence          Float?
  semanticStatus      String   @default("DETERMINISTIC")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assessment  KnowledgeAssessment           @relation(fields: [assessmentId], references: [id])
  primaryUnit KnowledgeTextUnit?            @relation("KnowledgeFindingPrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: SetNull)
  evidence    KnowledgeAssessmentEvidence[]

  @@unique([assessmentId, ordinal])
  @@index([assessmentId, scope])
  @@index([primaryUnitId])
  @@index([kind])
}

// A finding may point to many sentences, spans, paragraphs, or cross-scope
// context records. refKey preserves the original SID even when unresolved.
model KnowledgeAssessmentEvidence {
  id             Int                        @id @default(autoincrement())
  findingId      Int
  unitId         Int?
  refKey         String?
  role           String
  quotedText     String?                    @db.LongText
  startOffset    Int?
  endOffset      Int?
  locationStatus AiAnnotationLocationStatus @default(PENDING)
  confidence     Float?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  finding KnowledgeAssessmentFinding @relation(fields: [findingId], references: [id])
  unit    KnowledgeTextUnit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([findingId])
  @@index([unitId])
  @@index([refKey])
  @@index([role])
}

model KnowledgeRewriteExample {
  id            Int      @id @default(autoincrement())
  documentId    Int
  sourceUnitId  Int?
  sourceKey     String
  scope         String
  sourceType    String
  layers        Json?
  originalText  String   @db.LongText
  rewrittenText String   @db.LongText
  reason        String?  @db.LongText
  sourceRefs    Json?
  sourceSheet   String?
  sourceRow     Int?
  sourceColumn  String?
  rawText       String?  @db.LongText
  allowedForRag Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  document   KnowledgeDocument  @relation(fields: [documentId], references: [id])
  sourceUnit KnowledgeTextUnit? @relation(fields: [sourceUnitId], references: [id], onDelete: SetNull)

  @@unique([documentId, sourceKey])
  @@index([documentId, scope])
  @@index([sourceUnitId])
  @@index([sourceType])
  @@index([allowedForRag])
}

// Row-level source ledger for lossless reprocessing and audit.
model KnowledgeSourceRecord {
  id         Int      @id @default(autoincrement())
  documentId Int
  sourceKey  String
  sheetName  String
  rowIndex   Int?
  recordType String
  rawJson    Json
  sourceHash String?
  createdAt  DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id])

  @@unique([documentId, sourceKey])
  @@index([documentId, sheetName])
  @@index([recordType])
}

model KnowledgeEmbedding {
  id            Int                      @id @default(autoincrement())
  chunkId       Int
  provider      String
  model         String
  embeddingRole EmbeddingRole            @default(PRIMARY)
  vectorJson    Json?
  vectorRef     String?
  dimensions    Int?
  contentHash   String?
  status        KnowledgeEmbeddingStatus @default(PENDING)
  errorMessage  String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id])

  @@unique([chunkId, provider, model, embeddingRole])
  @@index([provider, model, status])
  @@index([embeddingRole])
}

model RetrievalEvent {
  id        Int      @id @default(autoincrement())
  jobId     Int
  query     String   @db.Text
  topK      Int
  strategy  String   @default("keyword")
  createdAt DateTime @default(now())

  job    AiReviewJob           @relation(fields: [jobId], references: [id])
  chunks RetrievalEventChunk[]

  @@index([jobId])
}

model RetrievalEventChunk {
  id               Int      @id @default(autoincrement())
  retrievalEventId Int
  chunkId          Int
  rank             Int
  similarityScore  Float?
  usedInPrompt     Boolean  @default(true)
  createdAt        DateTime @default(now())

  retrievalEvent RetrievalEvent @relation(fields: [retrievalEventId], references: [id])
  chunk          KnowledgeChunk @relation(fields: [chunkId], references: [id])

  @@unique([retrievalEventId, chunkId])
  @@index([chunkId])
}

model Reflection {
  id           Int      @id @default(autoincrement())
  userId       Int
  title        String
  content      String   @db.Text
  tags         String?
  submissionId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  submission Submission? @relation(fields: [submissionId], references: [id])
}

model Payment {
  id        Int              @id @default(autoincrement())
  userId    Int
  amount    Float
  tier      SubscriptionTier
  status    PaymentStatus    @default(PENDING)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CorrectionCode {
  id                 Int       @id @default(autoincrement())
  code               String    @unique
  type               CodeType
  isUsed             Boolean   @default(false)
  usedBy             Int?
  usedAt             DateTime?
  usedInSubmissionId Int?      @unique
  createdAt          DateTime  @default(now())

  user       User?       @relation(fields: [usedBy], references: [id])
  submission Submission? @relation(fields: [usedInSubmissionId], references: [id])
}

model Message {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @default("other")
  title     String
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model EssayViewLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  essayId   Int
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id])
  essay ModelEssay @relation(fields: [essayId], references: [id])

  @@unique([userId, essayId])
}

model QuestionViewLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  questionId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

// 告示板公告（可动态增删改）
model Notice {
  id        Int      @id @default(autoincrement())
  type      String // "update" | "notice" | "tip"
  title     String
  content   String   @db.Text
  date      String // 显示用，如 "2026-03-20"
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 通用站点配置（键值对，存所有其他可配置内容）
model SiteConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique // 如 "about_intro", "stats", "teachers"
  value     String   @db.LongText // JSON 字符串
  updatedAt DateTime @updatedAt
}

