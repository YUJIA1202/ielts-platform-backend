// ─────────────────────────────────────────────
// V6 新增枚举
// ─────────────────────────────────────────────

enum AnchorType {
  SPAN // 正常框住词/短语/句 (start≠end)
  POINT_BEFORE // 零宽，锚在某位置之前
  POINT_AFTER // 零宽，锚在某位置之后（如词尾空格）
  RELATION // 针对两个单元之间的关系（句间/段间）
  TEACHER_NOTE // 不对应原文位置的全局讲解
}

enum RelationType {
  CAUSAL // 因果
  COHESION // 衔接
  CONTRAST // 转折
  PROGRESSION // 递进
}

enum GoldStandardSource {
  AUTO // 按 issueType 自动匹配
  MANUAL // 人工确认
}

enum HardNegativeType {
  WRONG_TASK
  WRONG_ISSUE
  TOO_GENERIC
  MISLEADING
  DUPLICATE
}

enum EmbeddingRole {
  PRIMARY // 默认主检索向量
  STRUCTURE // 结构通道专用
  TOPIC // 话题通道专用
  LANGUAGE_ERROR // 语言错误通道专用
}

enum FusionMethod {
  LINEAR
  RRF
  WEIGHTED_RRF
}

// ─────────────────────────────────────────────
// V6 P0：教师批注结构化（地基中的地基）
// ─────────────────────────────────────────────

model KnowledgeAnnotation {
  id                 Int                        @id @default(autoincrement())
  documentId         Int
  chunkId            Int?
  commentId          String?
  paragraphIndex     Int?
  sentenceIndex      Int?
  anchorType         AnchorType                 @default(SPAN)
  anchorText         String?                    @db.Text
  startOffset        Int?
  endOffset          Int?
  occurrence         Int?
  attachedTokenIndex Int?
  sourceRef          String?
  targetRef          String?
  relationType       RelationType?
  issueType          String?
  issueSubtype       String?
  severity           AiIssueSeverity            @default(MEDIUM)
  teacherFeedback    String?                    @db.Text
  replacementText    String?                    @db.Text
  locationStatus     AiAnnotationLocationStatus @default(PENDING)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  document KnowledgeDocument @relation(fields: [documentId], references: [id])
  chunk    KnowledgeChunk?   @relation(fields: [chunkId], references: [id])

  @@index([documentId])
  @@index([chunkId])
  @@index([issueType])
  @@index([anchorType])
}

// ─────────────────────────────────────────────
// V6 P0：检索金标准（调参的标准答案）
// ─────────────────────────────────────────────

model RetrievalGoldStandard {
  id              Int                @id @default(autoincrement())
  essayId         Int
  relevantChunkId Int
  issueType       String?
  channel         String?
  relevanceGrade  Int                @default(2)
  source          GoldStandardSource @default(AUTO)
  confirmedBy     Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  chunk KnowledgeChunk @relation(fields: [relevantChunkId], references: [id])

  @@unique([essayId, relevantChunkId])
  @@index([essayId])
  @@index([relevantChunkId])
  @@index([issueType])
}

// ─────────────────────────────────────────────
// V6 P0：实验可复现（每次实验唯一记录）
// ─────────────────────────────────────────────

model ExperimentRun {
  id            Int          @id @default(autoincrement())
  name          String?
  gitCommit     String?
  fusionMethod  FusionMethod @default(RRF)
  configJson    Json?
  topKGlobal    Int?
  topKParagraph Int?
  topKSentence  Int?
  rrfK          Int?
  mmrLambda     Float?
  seed          Int?
  status        String       @default("PENDING")
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())

  evaluations RetrievalEvaluation[]

  @@index([gitCommit])
}

// ─────────────────────────────────────────────
// V6 P1：离线检索指标
// ─────────────────────────────────────────────

model RetrievalEvaluation {
  id             Int      @id @default(autoincrement())
  runId          Int
  essayId        Int?
  channel        String?
  issueType      String?
  recallAtK      Float?
  ndcgAtK        Float?
  precisionAtK   Float?
  noiseRate      Float?
  diversityScore Float?
  topK           Int?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  run ExperimentRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([essayId])
}

// ─────────────────────────────────────────────
// V6 新增：检索硬负样本
// ─────────────────────────────────────────────

model RetrievalHardNegative {
  id           Int                @id @default(autoincrement())
  queryEssayId Int?
  queryUnitId  String?
  chunkId      Int
  negativeType HardNegativeType
  severity     AiIssueSeverity    @default(MEDIUM)
  createdBy    Int?
  source       GoldStandardSource @default(MANUAL)
  notes        String?            @db.Text
  createdAt    DateTime           @default(now())

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id])

  @@index([queryEssayId])
  @@index([chunkId])
}

// ─────────────────────────────────────────────
// V6 P0：数据导入批次（可重导机制）
// ─────────────────────────────────────────────

model ImportBatch {
  id              Int      @id @default(autoincrement())
  label           String?
  sourceFileHash  String?
  parserVersion   String?
  cleaningVersion String?
  isActive        Boolean  @default(true)
  importedCount   Int?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([sourceFileHash])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// V6 P0：评分规则版本化
// ─────────────────────────────────────────────

model RubricVersion {
  id        Int       @id @default(autoincrement())
  version   String    @unique
  content   String    @db.LongText
  taskType  TaskType?
  changelog String?   @db.Text
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────────
// V6 P0：输出 JSON schema 版本化
// ─────────────────────────────────────────────

model OutputSchemaVersion {
  id         Int      @id @default(autoincrement())
  version    String   @unique
  schemaJson Json
  changelog  String?  @db.Text
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────────
// V6 P2：人工盲评记录
// ─────────────────────────────────────────────

model HumanReviewAudit {
  id                 Int      @id @default(autoincrement())
  reviewId           Int
  auditorId          Int
  configLabel        String?
  problemReality     Int?
  locationAccuracy   Int?
  explanationQuality Int?
  suggestionQuality  Int?
  teacherLikeness    Int?
  studentClarity     Int?
  overallScore       Float?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())

  review  AiReview @relation(fields: [reviewId], references: [id])
  auditor User     @relation(fields: [auditorId], references: [id])

  @@index([reviewId])
  @@index([auditorId])
}
