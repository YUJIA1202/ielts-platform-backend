# Database and application configuration
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/ielts_platform"
PORT=4000
NODE_ENV=development

# DeepSeek structured AI review. Never put a real key in this example file.
AI_PROVIDER=DEEPSEEK
AI_PROVIDER_BASE_URL=https://api.deepseek.com
AI_PROVIDER_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
# AI_PROVIDER_API_KEY=
AI_PROVIDER_THINKING=enabled
AI_PROVIDER_REASONING_EFFORT=high

# Initial multilingual RAG baseline: Zhipu embedding-3.
ZHIPU_API_KEY=
AI_EMBEDDING_PROVIDER=ZHIPU
AI_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_EMBEDDING_MODEL=embedding-3
AI_EMBEDDING_DIMENSIONS=2048
AI_RERANK_ENABLED=false

# Required only by scripts/run-first-live-task2-review.ts.
AI_EXPERIMENT_PASSWORD=

# Optional quality comparison: use one Voyage key for embedding and reranking.
# VOYAGE_API_KEY=
# AI_EMBEDDING_PROVIDER=VOYAGE
# AI_EMBEDDING_BASE_URL=https://api.voyageai.com/v1
# AI_EMBEDDING_MODEL=voyage-4-large
# AI_EMBEDDING_DIMENSIONS=2048
# AI_RERANK_ENABLED=true
# AI_RERANK_PROVIDER=VOYAGE
# AI_RERANK_BASE_URL=https://api.voyageai.com/v1
# AI_RERANK_MODEL=rerank-2.5
# AI_RERANK_CANDIDATE_LIMIT=60

# Optional evaluation switch. Use keyword to disable vector retrieval for A/B tests.
# AI_RAG_MODE=keyword
